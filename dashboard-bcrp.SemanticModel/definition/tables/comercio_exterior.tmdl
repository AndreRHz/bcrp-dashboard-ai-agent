table comercio_exterior
	lineageTag: 08390de0-3b61-49d3-bb4c-a80906048abf

	measure 'Precio en paradoja' = CALCULATE(AVERAGE(comercio_exterior[precio_x_var]), comercio_exterior[ParadojaMarcada] = 1)

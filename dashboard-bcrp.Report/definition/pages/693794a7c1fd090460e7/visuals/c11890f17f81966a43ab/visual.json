                      "fontSize": "6pt",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "¿Qué es la paradoja?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#d64545"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "El volumen exportado sube mientras el precio cae más de 5% (frente al mismo trimestre del año anterior).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
